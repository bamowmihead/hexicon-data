[
  {
    "chart_cell": "targets/living/anima/infuse",
    "energy": "anima",
    "handler": "endurance",
    "id": 1,
    "label": "Restores",
    "params_json": {},
    "rule_text": "[L] Restores endurance = dice rolled + Willpower bonus\nAnima dice cost half the size of the dice.\nD4=2 D6=3 etc.\nDoes not restore wounds",
    "sort_order": 0,
    "status": "L",
    "target_kind": "living",
    "verb": "infuse"
  },
  {
    "chart_cell": "targets/living/anima/siphon",
    "energy": "anima",
    "handler": "endurance",
    "id": 2,
    "label": "Drains",
    "params_json": {},
    "rule_text": "[L] Drains endurance = dice rolled + Willpower bonus.\nDoes not deal wounds. \nWhen endurance drops to 0 target's speed is halves until they regain endurance  their endurance stays at 0 effectively making them one hit from taking a wound from any damage they're not immune to or better.\n[Y] Siphon costs no energy. You get back half of what you deal, into your Endurance or your Energy pool (your choice). Example: 1d8+2, roll 4 → deal 6, recover 3.\n[Y] Soul roads are a massive siphon, taxing life force from everything living along them.",
    "sort_order": 1,
    "status": "L",
    "target_kind": "living",
    "verb": "siphon"
  },
  {
    "chart_cell": "targets/living/ichor/infuse",
    "energy": "ichor",
    "handler": "wound",
    "id": 3,
    "label": "Heals wound",
    "params_json": {},
    "rule_text": "[Y] Heals wounds, using ichor you carry or pulled.\n[M] 1 ichor closes 1 wound, no roll.",
    "sort_order": 2,
    "status": "Y",
    "target_kind": "living",
    "verb": "infuse"
  },
  {
    "chart_cell": "targets/living/ichor/siphon",
    "energy": "ichor",
    "handler": "wound",
    "id": 4,
    "label": "Wounds",
    "params_json": {},
    "rule_text": "[Y] ×1. Wounds only if the damage takes Endurance to 0; otherwise no effect.\n[Y] Pulled ichor is pure.\n[Y] Pulling from a living creature's natural armour is ichor, not umbra.\n[Y] Late: already wounded and the damage beats max Endurance = two wounds.\n[Y] Draining ichor is what makes bones brittle, which is why it can wound.",
    "sort_order": 3,
    "status": "Y",
    "target_kind": "living",
    "verb": "siphon"
  },
  {
    "chart_cell": "targets/living/umbra/infuse",
    "energy": "umbra",
    "handler": "deviation",
    "id": 5,
    "label": "Hardens",
    "params_json": {},
    "rule_text": "[Y] Each step: +1 Defense and −2 Speed. At Speed 0 they're encased.\n[Y] Encasement suffocates over several minutes, which is lethal. The meat inside is perfectly preserved and doesn't rot: a way of preserving food.",
    "sort_order": 4,
    "status": "Y",
    "target_kind": "living",
    "verb": "infuse"
  },
  {
    "chart_cell": "targets/living/umbra/siphon",
    "energy": "umbra",
    "handler": "wound",
    "id": 6,
    "label": "Lightens",
    "params_json": {
      "wound_type": "Umbral drain"
    },
    "rule_text": "[Y] Reduces max Endurance and makes them lighter.\n[Y] Drain enough and they collapse, bones like rubber. Not lethal.\n[Y] Technically deals wounds; the wound type causes these effects.",
    "sort_order": 5,
    "status": "Y",
    "target_kind": "living",
    "verb": "siphon"
  },
  {
    "chart_cell": "targets/living/aether/infuse",
